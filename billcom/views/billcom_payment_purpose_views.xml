<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View billcom.payment.purpose View Tree -->
    <record id="view_billcom_payment_purpose_tree" model="ir.ui.view">
        <field name="name">view.billcom.payment.purpose.tree</field>
        <field name="model">billcom.payment.purpose</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- View billcom.payment.purpose form -->
    <record id="view_billcom_payment_purpose_form" model="ir.ui.view">
        <field name="name">view.billcom.payment.purpose.form</field>
        <field name="model">billcom.payment.purpose</field>
        <field name="arch" type="xml">
            <form string="Billcom Payment Purpose">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="country_id"/>
                        </group>
                        <group>
                            <field name="description" widget="text"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View billcom.payment.purpose search -->
    <record id="view_billcom_payment_purpose_search" model="ir.ui.view">
        <field name="name">view.billcom.payment.purpose.search</field>
        <field name="model">billcom.payment.purpose</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action billcom.payment.purpose -->
    <record id="action_billcom_payment_purpose" model="ir.actions.act_window">
        <field name="name">Billcom Payment Purpose</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">billcom.payment.purpose</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Billcom Payment Purpose.
            </p>
        </field>
    </record>

</odoo>
